# Route settings writes to the real file so they never replace the settings.yaml symlink.
- id: settings
  name: '@deepseek-ai/dsh-settings-file'
  config:
    path: {{ .chezmoi.sourceDir }}/symlinks/dsh/settings.yaml

# Chezmoi auto-sync after write/edit tool results.
- insert:
    - id: chezmoi
      name: ../../plugins/dsh-plugin-chezmoi.mjs

# Pi agent prompts as slash commands.
- insert:
    - id: pi-prompts
      name: ../../plugins/dsh-plugin-pi-prompts.mjs
