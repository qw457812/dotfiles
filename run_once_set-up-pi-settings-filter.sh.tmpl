#!/bin/sh
set -e

# Pi writes machine-local state into its settings.json; strip it so the dotfiles copy stays shareable.
# Applied via the dotfiles repo's .gitattributes. https://github.com/earendil-works/pi/issues/10187
git -C {{ .chezmoi.sourceDir | quote }} config filter.pi-settings.clean \
  "jq 'del(.deviceId, .lastChangelogVersion)'"
# Fix checkout failures for required filters by passing content through unchanged.
# e.g. "fatal: symlinks/pi/agent/settings.json: smudge filter pi-settings failed" on `chezmoi update`
git -C {{ .chezmoi.sourceDir | quote }} config filter.pi-settings.smudge cat
# Fail instead of committing unfiltered content if jq is missing
git -C {{ .chezmoi.sourceDir | quote }} config filter.pi-settings.required true
