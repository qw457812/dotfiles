// https://opencode.ai/docs/zen/#pricing
// curl https://opencode.ai/zen/v1/models | jq '.data | sort_by(.created)'
{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  // "autoupdate": "notify",
  "model": "zai-coding-plan/glm-5.2",
  "small_model": "deepseek/deepseek-v4-flash",
  "agent": {
    "plan": {
      "model": "zai-coding-plan/glm-5.2"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "oauth": false,
      "enabled": false
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa", // opencode already has built-in `webfetch` tool
      "enabled": true
    }
  },
  "permission": {
    // https://github.com/anomalyco/opencode/blob/7c6948cf6f90b52a74ad56ac7a7eb16863e65f19/packages/web/src/content/docs/tools.mdx?plain=1#L255-L281
    "websearch": "deny", // for OpenCode provider, we already have `exa_web_search_exa` via exa MCP
    "codesearch": "deny", // for OpenCode provider, `get_code_context_exa` is deprecated by exa
    "bash": {
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git pull *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git stash *": "ask",
      "git cherry-pick *": "ask",
      "git revert *": "ask",
      "git restore *": "ask",
      "git clean *": "ask"
    }
  },
  "provider": {
    "synthetic": {
      "models": {
        "hf:zai-org/GLM-5.1": {
          "name": "GLM 5.1",
          "family": "glm",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "cost": {
            "input": 1,
            "output": 3
          },
          "limit": {
            "context": 196608,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    // curl https://openrouter.ai/api/v1/models | jq '.data | sort_by(.created)' | less
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENCODE_OPENROUTER_API_KEY}"
      },
    }
  },
  "disabled_providers": [
    "alibaba",
    "alibaba-cn",
    // "deepseek",
    "groq",
    "kimi-for-coding",
    "minimax",
    "minimax-cn",
    "minimax-cn-coding-plan",
    "minimax-coding-plan",
    "modelscope",
    "moonshotai",
    "moonshotai-cn",
    "openrouter",
    "togetherai",
    "zai",
    // "zai-coding-plan",
    "zhipuai",
    "zhipuai-coding-plan"
  ]
}
