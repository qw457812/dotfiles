# see: `ghostty +show-config --default --docs`

font-family = "Maple Mono NF CN"
font-feature = "+cv35, +cv61, +cv62, +ss06"
font-size = 12

mouse-hide-while-typing = true
quit-after-last-window-closed = true

macos-option-as-alt = true
macos-titlebar-style = tabs
macos-window-buttons = hidden

keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+l=goto_split:right
keybind = performable:ctrl+left=resize_split:left,30
keybind = performable:ctrl+down=resize_split:down,30
keybind = performable:ctrl+up=resize_split:up,30
keybind = performable:ctrl+right=resize_split:right,30

# https://github.com/smart-splits-nvim/backend-ghostty/blob/0ea13a1684cb2c838f5fa47f8ce251a1fca47c76/README.md?plain=1#L137-L164
keybind = nvim/
keybind = nvim/ctrl+h=text:\x08
keybind = nvim/ctrl+j=text:\x0a
keybind = nvim/ctrl+k=text:\x0b
keybind = nvim/ctrl+l=text:\x0c
keybind = nvim/ctrl+left=csi:1;5D
keybind = nvim/ctrl+down=csi:1;5B
keybind = nvim/ctrl+up=csi:1;5A
keybind = nvim/ctrl+right=csi:1;5C

keybind = super+m=toggle_split_zoom
keybind = super+enter=new_split:auto
keybind = super+space=write_screen_file:open,vt
keybind = super+k=previous_tab
keybind = super+j=next_tab
keybind = super+[=move_tab:-1
keybind = super+]=move_tab:1
# keybind = super+r=reload_config
keybind = super+u=scroll_page_fractional:-0.5
keybind = super+d=scroll_page_fractional:0.5

copy-on-select = clipboard
right-click-action = paste

# see: `ghostty +list-themes --color=dark`
theme = TokyoNight Moon
background-image = ~/wallpapers/wall3.png
background-image-opacity = 0.125
background-image-fit = cover

# cursor-invert-fg-bg = true
adjust-cursor-thickness = 2
