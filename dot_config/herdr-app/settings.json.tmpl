{
  "zoom": 1,
  "sounds": {
    "enabled": true
  },
  "font_ligatures": false,
  "terminal_line_height": 1,
  "terminal_cell_width": 1,
  "terminal_scroll_speed": 1,
  "minimum_contrast": 1,
  "option_as_alt": "on",
  "font": "{{ if eq .chezmoi.os "linux" }}Maple Mono Normal NF CN{{ else }}Maple Mono NF CN{{ end }}",
  "font_size": {{ if eq .chezmoi.os "linux" }}16{{ else }}12{{ end }}
}
