;; Fedora Asahi: only remap the MacBook's built-in keyboard.
;; These tap-hold actions approximate, but are not identical to, Goku simlayers.
(defcfg
  linux-dev-names-include ("Apple MTP keyboard")
  process-unmapped-keys yes
  concurrent-tap-hold yes
  danger-enable-cmd yes
)

(defsrc
  spc v m f j k scln lmet lalt rmet
)

(defalias
  ;; Tap normally; hold with another key to activate the modifier/layer.
  ;; Alternative: activate Shift immediately when another key is pressed.
  ;; space-shift (tap-hold-press 250 250 spc lsft)
  space-shift (tap-hold-release 250 250 spc lsft)
  v-ctrl (tap-hold-release 250 250 v lctl)
  m-ctrl (tap-hold-release 250 250 m lctl)
  ;; Fedora: tap left Command to switch apps; hold as Super.
  cmd-alone (tap-hold-press 0 250 A-tab lmet)
  ;; Globally send the tmux prefix on tap; hold as Alt.
  option-alone (tap-hold-press 0 250 C-b lalt)
  ;; Right Command is a dedicated launcher-layer key, not Super.
  launcher (layer-while-held launcher)
  open-glide (cmd /usr/bin/env kde-focus-or-launch glide)
  open-kitty (cmd /usr/bin/env kde-focus-or-launch kitty)
  ;; Other standard keys resolve to plain f; only j activates f-mode.
  ;; Unlike ordinary tap-hold, waiting alone does not activate the layer.
  f-layer (tap-hold-except-keys 250 250 f (layer-while-held f-mode)
    (esc f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
     grv 1 2 3 4 5 6 7 8 9 0 - = bspc
     tab q w e r t y u i o p [ ] bksl
     caps a s d f g h k l scln '
     lsft z x c v b n m , . / rsft
     lctl lmet lalt spc ralt rmet rctl
     ins del home end pgup pgdn left down up rght))
  ;; Invert Shift for this key, including Shift provided by Space.
  semicolon (fork S-scln (unshift scln) (lsft rsft))
)

(deflayer base
  @space-shift @v-ctrl @m-ctrl @f-layer j k @semicolon @cmd-alone @option-alone @launcher
)

(deflayer f-mode
  _ _ _ _ bspc _ _ _ _ _
)

(deflayer launcher
  _ _ _ _ @open-glide @open-kitty _ _ _ _
)

;; Match the original Goku profile's 30 ms simultaneous-key window.
;; Disable in f-mode and launcher so their j/k actions take precedence.
(defchordsv2
  (j k) esc 30 first-release (f-mode launcher)
)
