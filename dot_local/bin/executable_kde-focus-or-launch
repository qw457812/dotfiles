#!/bin/sh
# Focus an existing KDE window before launching another instance.
set -eu

case "${1:-}" in
  glide) class='^glide-glide$' ;;
  kitty) class='^kitty$' ;;
  ghostty) class='^com\.mitchellh\.ghostty$' ;;
  krdc) class='^org\.kde\.krdc$' ;;
  bitwarden) class='^bitwarden$' ;;
  settings) class='^systemsettings$' ;;
  *)
    printf 'Usage: %s glide|kitty|ghostty|krdc|bitwarden|settings\n' "$0" >&2
    exit 2
    ;;
esac

# Do not launch a duplicate if the window query itself fails.
window=$(kdotool search --limit 1 --class "$class")
if [ -n "$window" ]; then
  exec kdotool windowactivate "$window"
fi

# Use a separate user service so restarting Kanata does not kill the app.
case "$1" in
  glide) exec systemd-run --user --collect -- "$HOME/.local/bin/glide" ;;
  kitty) exec systemd-run --user --collect -- /usr/bin/kitty ;;
  ghostty) exec systemd-run --user --collect -- /usr/bin/ghostty ;;
  krdc) exec systemd-run --user --collect -- /usr/bin/krdc ;;
  bitwarden) exec systemd-run --user --collect -- /usr/bin/flatpak run com.bitwarden.desktop ;;
  settings) exec systemd-run --user --collect -- /usr/bin/systemsettings ;;
esac
