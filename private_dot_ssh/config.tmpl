{{- if eq .chezmoi.os "darwin" }}
Include ~/.colima/ssh_config
{{- end }}

Host *
  AddKeysToAgent yes
  ServerAliveInterval 15
  ControlMaster auto
  ControlPath ~/.ssh/%C
  ControlPersist 10m
{{- if eq .chezmoi.os "darwin" }}
  UseKeychain yes
{{- end }}

Include config.local

Host gh
  Hostname github.com
  User git
